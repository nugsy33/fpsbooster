--========================================================
-- ULTRA FPS BOOST v3
-- STABLE / LOW STUTTER / MODERN UI
-- MINIMIZE + FUTURISTIC N LOGO
--========================================================

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")

local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

--========================================================
-- SETTINGS
--========================================================

local BATCH_SIZE = 35
local BATCH_DELAY = 0.05

local ReapplyOptions = {
	["OFF"] = 0,
	["5 MIN"] = 300,
	["15 MIN"] = 900,
	["30 MIN"] = 1800,
	["1 HOUR"] = 3600
}

--========================================================
-- STATE
--========================================================

local FPSBoost = false
local ReapplyMode = "OFF"

local Saved = {}

local Queue = {}
local QueueIndex = 1
local QueuedObjects = {}

local WorkerRunning = false
local ScanRunning = false
local ReapplyRunning = false

local Destroyed = false

--========================================================
-- CHARACTER CHECK
--========================================================

local function IsCharacter(obj)

	if not obj then
		return true
	end

	for _, player in ipairs(Players:GetPlayers()) do

		local character = player.Character

		if character and obj:IsDescendantOf(character) then
			return true
		end
	end

	return false
end

--========================================================
-- SAVE ORIGINAL SETTINGS
--========================================================

local function SaveObject(obj)

	if Saved[obj] then
		return
	end

	if obj:IsA("BasePart") then

		Saved[obj] = {
			Type = "BasePart",
			LocalTransparencyModifier =
				obj.LocalTransparencyModifier,
			CastShadow =
				obj.CastShadow
		}

	elseif obj:IsA("Decal")
		or obj:IsA("Texture") then

		Saved[obj] = {
			Type = "Texture",
			Transparency =
				obj.Transparency
		}

	elseif obj:IsA("ParticleEmitter")
		or obj:IsA("Trail")
		or obj:IsA("Beam")
		or obj:IsA("Smoke")
		or obj:IsA("Fire")
		or obj:IsA("Sparkles") then

		Saved[obj] = {
			Type = "Effect",
			Enabled =
				obj.Enabled
		}
	end
end

--========================================================
-- PROCESS OBJECT
--========================================================

local function ProcessObject(obj)

	if not FPSBoost then
		return
	end

	if not obj then
		return
	end

	if not obj.Parent then
		return
	end

	if IsCharacter(obj) then
		return
	end

	--====================================================
	-- BASEPART
	--====================================================

	if obj:IsA("BasePart") then

		SaveObject(obj)

		-- Visual optimization only.
		-- Collision is intentionally untouched.
		obj.LocalTransparencyModifier = 1
		obj.CastShadow = false

		return
	end

	--====================================================
	-- DECAL / TEXTURE
	--====================================================

	if obj:IsA("Decal")
		or obj:IsA("Texture") then

		SaveObject(obj)

		obj.Transparency = 1

		return
	end

	--====================================================
	-- PARTICLE / EFFECT
	--====================================================

	if obj:IsA("ParticleEmitter")
		or obj:IsA("Trail")
		or obj:IsA("Beam")
		or obj:IsA("Smoke")
		or obj:IsA("Fire")
		or obj:IsA("Sparkles") then

		SaveObject(obj)

		obj.Enabled = false

		return
	end
end

--========================================================
-- QUEUE OBJECT
--========================================================

local function QueueObject(obj)

	if not FPSBoost then
		return
	end

	if not obj then
		return
	end

	if not obj.Parent then
		return
	end

	if IsCharacter(obj) then
		return
	end

	if QueuedObjects[obj] then
		return
	end

	QueuedObjects[obj] = true

	Queue[#Queue + 1] = obj
end

--========================================================
-- WORKER
--========================================================

local function StartWorker()

	if WorkerRunning then
		return
	end

	WorkerRunning = true

	task.spawn(function()

		while FPSBoost and not Destroyed do

			local processed = 0

			while FPSBoost
				and not Destroyed
				and QueueIndex <= #Queue
				and processed < BATCH_SIZE
			do

				local obj = Queue[QueueIndex]

				QueueIndex += 1
				processed += 1

				if obj then

					QueuedObjects[obj] = nil

					if obj.Parent then
						ProcessObject(obj)
					end
				end
			end

			-- Queue selesai
			if QueueIndex > #Queue then

				table.clear(Queue)
				table.clear(QueuedObjects)

				QueueIndex = 1

				break
			end

			task.wait(BATCH_DELAY)
		end

		WorkerRunning = false
	end)
end

--========================================================
-- FULL SCAN
--========================================================

local function StartFullScan()

	if not FPSBoost then
		return
	end

	if ScanRunning then
		return
	end

	ScanRunning = true

	task.spawn(function()

		local descendants

		pcall(function()
			descendants = Workspace:GetDescendants()
		end)

		if descendants then

			for _, obj in ipairs(descendants) do

				if not FPSBoost
					or Destroyed then
					break
				end

				QueueObject(obj)

				-- Jangan memenuhi queue sekaligus.
				if #Queue >= BATCH_SIZE * 3 then
					StartWorker()
					task.wait()
				end
			end
		end

		ScanRunning = false

		StartWorker()
	end)
end

--========================================================
-- NEW OBJECT DETECTION
--========================================================

local DescendantConnection

DescendantConnection =
	Workspace.DescendantAdded:Connect(function(obj)

		if not FPSBoost then
			return
		end

		QueueObject(obj)
		StartWorker()
	end)

--========================================================
-- RESTORE OBJECTS
--========================================================

local function RestoreObjects()

	for obj, data in pairs(Saved) do

		if obj and obj.Parent then

			if data.Type == "BasePart" then

				obj.LocalTransparencyModifier =
					data.LocalTransparencyModifier

				obj.CastShadow =
					data.CastShadow

			elseif data.Type == "Texture" then

				obj.Transparency =
					data.Transparency

			elseif data.Type == "Effect" then

				obj.Enabled =
					data.Enabled
			end
		end
	end
end

--========================================================
-- CLEAR QUEUE
--========================================================

local function ClearQueue()

	table.clear(Queue)
	table.clear(QueuedObjects)

	QueueIndex = 1
end

--========================================================
-- ENABLE
--========================================================

local function EnableFPSBoost()

	if FPSBoost then
		return
	end

	FPSBoost = true

	ClearQueue()

	StartFullScan()
end

--========================================================
-- DISABLE
--========================================================

local function DisableFPSBoost()

	if not FPSBoost then
		return
	end

	FPSBoost = false

	ReapplyRunning = false

	ClearQueue()

	RestoreObjects()
end

--========================================================
-- REAPPLY LOOP
--========================================================

local function StartReapply()

	ReapplyRunning = false

	local seconds =
		ReapplyOptions[ReapplyMode]

	if not seconds or seconds <= 0 then
		return
	end

	ReapplyRunning = true

	task.spawn(function()

		while FPSBoost
			and ReapplyRunning
			and not Destroyed
		do

			task.wait(seconds)

			if not FPSBoost
				or not ReapplyRunning
				or Destroyed then
				break
			end

			if not ScanRunning then
				StartFullScan()
			end
		end
	end)
end

