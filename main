--========================================================
-- ULTRA FPS BOOST
-- OPTIMIZED / LOW STUTTER
-- LocalScript -> StarterPlayerScripts
--========================================================

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local Player = Players.LocalPlayer

--========================================================
-- SETTINGS
--========================================================

local FPSBoost = false

-- Ukuran Virtual Floor
local FLOOR_SIZE = 500

-- Object yang diproses setiap batch
local BATCH_SIZE = 75

-- Jarak minimum sebelum floor dipindahkan
local FLOOR_MOVE_DISTANCE = 4

-- Jarak yang dianggap teleport
local TELEPORT_DISTANCE = 30

-- Jeda antar batch
local BATCH_DELAY = 0.03

--========================================================
-- REAPPLY SETTINGS
--========================================================

local ReapplyOptions = {
	["OFF"] = 0,
	["5 MIN"] = 300,
	["15 MIN"] = 900,
	["30 MIN"] = 1800,
	["1 HOUR"] = 3600
}

local ReapplyMode = "5 MIN"
local ReapplyThread = nil

--========================================================
-- STORAGE
--========================================================

local Saved = {}

local ObjectQueue = {}
local QueueIndex = 1
local QueuedObjects = {}

local ProcessingQueue = false

--========================================================
-- VIRTUAL FLOOR
--========================================================

local VirtualFloor = nil
local FloorConnection = nil

local FloorY = nil
local LastFloorPosition = nil

--========================================================
-- CHARACTER CHECK
--========================================================

local function IsCharacter(obj)

	for _, player in ipairs(Players:GetPlayers()) do

		local character = player.Character

		if character and obj:IsDescendantOf(character) then
			return true
		end

	end

	return false
end

--========================================================
-- SAVE ORIGINAL SETTINGS
--========================================================

local function SaveObject(obj)

	if Saved[obj] then
		return
	end

	-- BasePart
	if obj:IsA("BasePart") then

		Saved[obj] = {
			Type = "BasePart",
			CanCollide = obj.CanCollide,
			CanTouch = obj.CanTouch,
			CanQuery = obj.CanQuery,
			CastShadow = obj.CastShadow
		}

	-- Decal / Texture
	elseif obj:IsA("Decal") or obj:IsA("Texture") then

		Saved[obj] = {
			Type = "Texture",
			Transparency = obj.Transparency
		}

	-- Effects
	elseif obj:IsA("ParticleEmitter")
		or obj:IsA("Trail")
		or obj:IsA("Beam")
		or obj:IsA("Smoke")
		or obj:IsA("Fire")
		or obj:IsA("Sparkles") then

		Saved[obj] = {
			Type = "Effect",
			Enabled = obj.Enabled
		}

	end
end

--========================================================
-- PROCESS OBJECT
--========================================================

local function ProcessObject(obj)

	if not FPSBoost then
		return
	end

	if not obj then
		return
	end

	if not obj.Parent then
		return
	end

	-- Jangan proses Virtual Floor
	if obj == VirtualFloor then
		return
	end

	-- Jangan proses character
	if IsCharacter(obj) then
		return
	end

	--====================================================
	-- BASEPART
	--====================================================

	if obj:IsA("BasePart") then

		SaveObject(obj)

		obj.LocalTransparencyModifier = 1

		obj.CanCollide = false
		obj.CanTouch = false
		obj.CanQuery = false

		obj.CastShadow = false

		return
	end

	--====================================================
	-- DECAL / TEXTURE
	--====================================================

	if obj:IsA("Decal") or obj:IsA("Texture") then

		SaveObject(obj)

		obj.Transparency = 1

		return
	end

	--====================================================
	-- EFFECT
	--====================================================

	if obj:IsA("ParticleEmitter")
		or obj:IsA("Trail")
		or obj:IsA("Beam")
		or obj:IsA("Smoke")
		or obj:IsA("Fire")
		or obj:IsA("Sparkles") then

		SaveObject(obj)

		obj.Enabled = false

		return
	end

end

--========================================================
-- ADD OBJECT TO QUEUE
--========================================================

local function QueueObject(obj)

	if not FPSBoost then
		return
	end

	if not obj then
		return
	end

	if not obj.Parent then
		return
	end

	-- Jangan queue Virtual Floor
	if obj == VirtualFloor then
		return
	end

	-- Jangan duplicate
	if QueuedObjects[obj] then
		return
	end

	QueuedObjects[obj] = true

	ObjectQueue[#ObjectQueue + 1] = obj

end

--========================================================
-- PROCESS QUEUE
--========================================================

local function ProcessQueue()

	if ProcessingQueue then
		return
	end

	ProcessingQueue = true

	while FPSBoost do

		-- Semua object sudah diproses
		if QueueIndex > #ObjectQueue then
			break
		end

		local processed = 0

		while processed < BATCH_SIZE
			and QueueIndex <= #ObjectQueue do

			local obj = ObjectQueue[QueueIndex]

			QueueIndex += 1

			if obj then
				QueuedObjects[obj] = nil

				if obj.Parent then
					ProcessObject(obj)
				end
			end

			processed += 1
		end

		-- Beri waktu renderer/game bekerja
		task.wait(BATCH_DELAY)

	end

	ProcessingQueue = false

end

--========================================================
-- START FULL SCAN
--========================================================

local function StartFullScan()

	if not FPSBoost then
		return
	end

	-- Jangan membuat queue lama menumpuk
	if QueueIndex > #ObjectQueue then

		table.clear(ObjectQueue)
		table.clear(QueuedObjects)

		QueueIndex = 1

	end

	-- Snapshot object
	local descendants = Workspace:GetDescendants()

	for _, obj in ipairs(descendants) do

		if not FPSBoost then
			break
		end

		QueueObject(obj)

	end

	-- Jalankan processor
	task.spawn(ProcessQueue)

end

--========================================================
-- CREATE VIRTUAL FLOOR
--========================================================

local function CreateVirtualFloor()

	-- Hapus connection lama
	if FloorConnection then
		FloorConnection:Disconnect()
		FloorConnection = nil
	end

	-- Hapus floor lama
	if VirtualFloor then
		VirtualFloor:Destroy()
		VirtualFloor = nil
	end

	local character = Player.Character

	if not character then
		return
	end

	local root = character:FindFirstChild("HumanoidRootPart")

	if not root then
		return
	end

	--====================================================
	-- INITIAL POSITION
	--====================================================

	FloorY = root.Position.Y - 3.1

	LastFloorPosition = root.Position

	--====================================================
	-- CREATE PART
	--====================================================

	VirtualFloor = Instance.new("Part")

	VirtualFloor.Name = "FPSBoostVirtualFloor"

	VirtualFloor.Size = Vector3.new(
		FLOOR_SIZE,
		1,
		FLOOR_SIZE
	)

	VirtualFloor.Anchored = true

	-- PENTING
	VirtualFloor.CanCollide = true

	VirtualFloor.CanTouch = false
	VirtualFloor.CanQuery = false

	VirtualFloor.Transparency = 1

	VirtualFloor.CastShadow = false

	VirtualFloor.Position = Vector3.new(
		root.Position.X,
		FloorY,
		root.Position.Z
	)

	VirtualFloor.Parent = Workspace

	--====================================================
	-- FLOOR UPDATE
	--====================================================

	FloorConnection = RunService.Heartbeat:Connect(function()

		if not FPSBoost then
			return
		end

		if not VirtualFloor then
			return
		end

		if not VirtualFloor.Parent then
			return
		end

		if not root then
			return
		end

		if not root.Parent then
			return
		end

		local currentPosition = root.Position

		if not LastFloorPosition then

			LastFloorPosition = currentPosition

			return
		end

		local difference =
			currentPosition - LastFloorPosition

		local horizontalDistance =
			Vector3.new(
				difference.X,
				0,
				difference.Z
			).Magnitude

		local totalDistance =
			difference.Magnitude

		--================================================
		-- TELEPORT DETECTION
		--================================================

		if totalDistance >= TELEPORT_DISTANCE then

			FloorY =
				currentPosition.Y - 3.1

			VirtualFloor.Position =
				Vector3.new(
					currentPosition.X,
					FloorY,
					currentPosition.Z
				)

			LastFloorPosition =
				currentPosition

			return
		end

		--================================================
		-- NORMAL MOVEMENT
		--================================================

		if horizontalDistance >= FLOOR_MOVE_DISTANCE then

			VirtualFloor.Position =
				Vector3.new(
					currentPosition.X,
					FloorY,
					currentPosition.Z
				)

			LastFloorPosition =
				currentPosition

		end

		--================================================
		-- COLLISION SAFETY
		--================================================

		if not VirtualFloor.CanCollide then
			VirtualFloor.CanCollide = true
		end

	end)

end

--========================================================
-- REMOVE FLOOR
--========================================================

local function RemoveVirtualFloor()

	if FloorConnection then

		FloorConnection:Disconnect()

		FloorConnection = nil

	end

	if VirtualFloor then

		VirtualFloor:Destroy()

		VirtualFloor = nil

	end

	FloorY = nil
	LastFloorPosition = nil

end

--========================================================
-- ENABLE FPS BOOST
--========================================================

local function EnableFPSBoost()

	FPSBoost = true

	-- Buat floor dahulu
	CreateVirtualFloor()

	-- Scan map secara bertahap
	StartFullScan()

end

--========================================================
-- DISABLE FPS BOOST
--========================================================

local function DisableFPSBoost()

	FPSBoost = false

	-- Hentikan floor
	RemoveVirtualFloor()

	-- Bersihkan queue
	table.clear(ObjectQueue)

	table.clear(QueuedObjects)

	QueueIndex = 1

	--====================================================
	-- RESTORE OBJECT
	--====================================================

	for obj, data in pairs(Saved) do

		if obj and obj.Parent then

			-- BASEPART
			if data.Type == "BasePart" then

				obj.LocalTransparencyModifier = 0

				obj.CanCollide =
					data.CanCollide

				obj.CanTouch =
					data.CanTouch

				obj.CanQuery =
					data.CanQuery

				obj.CastShadow =
					data.CastShadow

			-- TEXTURE
			elseif data.Type == "Texture" then

				obj.Transparency =
					data.Transparency

			-- EFFECT
			elseif data.Type == "Effect" then

				obj.Enabled =
					data.Enabled

			end

		end

	end

end

--========================================================
-- REAPPLY TIMER
--========================================================

local function StartReapplyTimer()

	-- Stop timer lama
	if ReapplyThread then

		task.cancel(ReapplyThread)

		ReapplyThread = nil

	end

	local seconds =
		ReapplyOptions[ReapplyMode]

	if seconds == 0 then
		return
	end

	ReapplyThread = task.spawn(function()

		while FPSBoost do

			task.wait(seconds)

			if FPSBoost then

				StartFullScan()

			end

		end

	end)

end

--========================================================
-- NEW OBJECT DETECTION
--========================================================

Workspace.DescendantAdded:Connect(function(obj)

	if not FPSBoost then
		return
	end

	-- Virtual Floor jangan diproses
	if obj == VirtualFloor then
		return
	end

	-- Masukkan queue
	QueueObject(obj)

	-- Processor
	task.spawn(ProcessQueue)

end)

