--========================================================
-- UPDATE UI
--========================================================

local function UpdateUI()

	if FPSBoost then

		FPSButton.Text =
			"FPS BOOST    ON"

		FPSButton.BackgroundColor3 =
			Color3.fromRGB(
				35,
				125,
				75
			)

		FPSButton.TextColor3 =
			Color3.fromRGB(
				255,
				255,
				255
			)

		Dot.BackgroundColor3 =
			Color3.fromRGB(
				70,
				220,
				120
			)

		LogoDot.BackgroundColor3 =
			Color3.fromRGB(
				70,
				220,
				120
			)

		LogoStroke.Color =
			Color3.fromRGB(
				70,
				220,
				120
			)

	else

		FPSButton.Text =
			"FPS BOOST    OFF"

		FPSButton.BackgroundColor3 =
			Color3.fromRGB(
				36,
				37,
				45
			)

		FPSButton.TextColor3 =
			Color3.fromRGB(
				225,
				225,
				230
			)

		Dot.BackgroundColor3 =
			Color3.fromRGB(
				85,
				85,
				95
			)

		LogoDot.BackgroundColor3 =
			Color3.fromRGB(
				85,
				85,
				95
			)

		LogoStroke.Color =
			Color3.fromRGB(
				85,
				95,
				130
			)
	end

	ReapplyButton.Text =
		"Reapply: " ..
		ReapplyMode
end

--========================================================
-- MINIMIZE / RESTORE
--========================================================

local Minimized = false

Minimize.MouseButton1Click:Connect(function()

	if Minimized then
		return
	end

	Minimized = true

	Logo.Position =
		Main.Position

	Main.Visible = false
	Logo.Visible = true
end)

Logo.MouseButton1Click:Connect(function()

	if not Minimized then
		return
	end

	Minimized = false

	Main.Position =
		Logo.Position

	Logo.Visible = false
	Main.Visible = true
end)

--========================================================
-- FPS TOGGLE
--========================================================

FPSButton.MouseButton1Click:Connect(function()

	if FPSBoost then

		DisableFPSBoost()

	else

		EnableFPSBoost()
	end

	StartReapply()
	UpdateUI()
end)

--========================================================
-- REAPPLY BUTTON
--========================================================

local OptionOrder = {
	"OFF",
	"5 MIN",
	"15 MIN",
	"30 MIN",
	"1 HOUR"
}

local CurrentOption = 1

ReapplyButton.MouseButton1Click:Connect(function()

	CurrentOption += 1

	if CurrentOption > #OptionOrder then
		CurrentOption = 1
	end

	ReapplyMode =
		OptionOrder[CurrentOption]

	StartReapply()

	UpdateUI()
end)

--========================================================
-- DRAG SYSTEM
-- MAIN + LOGO
--========================================================

local Dragging = false
local DragObject = nil
local DragStart = nil
local StartPosition = nil

local function BeginDrag(object, input)

	Dragging = true
	DragObject = object

	DragStart =
		input.Position

	StartPosition =
		object.Position
end

local function EndDrag(object)

	if DragObject == object then

		Dragging = false
		DragObject = nil
	end
end

local function SetupDrag(object)

	object.InputBegan:Connect(function(input)

		if input.UserInputType ==
			Enum.UserInputType.MouseButton1

			or input.UserInputType ==
			Enum.UserInputType.Touch then

			BeginDrag(
				object,
				input
			)
		end
	end)

	object.InputEnded:Connect(function(input)

		if input.UserInputType ==
			Enum.UserInputType.MouseButton1

			or input.UserInputType ==
			Enum.UserInputType.Touch then

			EndDrag(object)
		end
	end)
end

SetupDrag(Main)
SetupDrag(Logo)

UserInputService.InputChanged:Connect(function(input)

	if not Dragging then
		return
	end

	if input.UserInputType ==
		Enum.UserInputType.MouseMovement

		or input.UserInputType ==
		Enum.UserInputType.Touch then

		local Delta =
			input.Position -
			DragStart

		DragObject.Position =
			UDim2.new(
				StartPosition.X.Scale,
				StartPosition.X.Offset +
					Delta.X,

				StartPosition.Y.Scale,
				StartPosition.Y.Offset +
					Delta.Y
			)
	end
end)

--========================================================
-- CHARACTER RESPAWN
--========================================================

Player.CharacterAdded:Connect(function()

	task.wait(1)

	if Destroyed then
		return
	end

	if FPSBoost then
		StartFullScan()
	end
end)

--========================================================
-- INITIAL UI
--========================================================

UpdateUI()

