--========================================================
-- UI UPDATE
--========================================================

local function UpdateFPSUI()

	if FPSBoost then

		FPSButton.Text =
			"FPS BOOST : ON"

		FPSButton.BackgroundColor3 =
			Color3.fromRGB(
				40,
				170,
				80
			)

		Status.Text =
			"Ultra optimizer active"

	else

		FPSButton.Text =
			"FPS BOOST : OFF"

		FPSButton.BackgroundColor3 =
			Color3.fromRGB(
				60,
				60,
				60
			)

		Status.Text =
			"Ready"

	end

end

--========================================================
-- FPS BUTTON
--========================================================

FPSButton.MouseButton1Click:Connect(function()

	if FPSBoost then

		DisableFPSBoost()

	else

		EnableFPSBoost()

		StartReapplyTimer()

	end

	UpdateFPSUI()

end)

--========================================================
-- REAPPLY OPTIONS
--========================================================

local OptionOrder = {

	"OFF",
	"5 MIN",
	"15 MIN",
	"30 MIN",
	"1 HOUR"

}

local CurrentOption = 2

ReapplyButton.MouseButton1Click:Connect(function()

	CurrentOption += 1

	if CurrentOption >
		#OptionOrder then

		CurrentOption = 1

	end

	ReapplyMode =
		OptionOrder[CurrentOption]

	ReapplyButton.Text =
		"REAPPLY : " ..
		ReapplyMode

	if FPSBoost then

		StartReapplyTimer()

	end

end)

--========================================================
-- DRAG UI
--========================================================

local Dragging = false
local DragStart = nil
local StartPosition = nil

Main.InputBegan:Connect(function(input)

	if input.UserInputType ==
		Enum.UserInputType.MouseButton1 then

		Dragging = true

		DragStart =
			input.Position

		StartPosition =
			Main.Position

	end

end)

Main.InputEnded:Connect(function(input)

	if input.UserInputType ==
		Enum.UserInputType.MouseButton1 then

		Dragging = false

	end

end)

UserInputService.InputChanged:Connect(function(input)

	if Dragging
		and input.UserInputType ==
		Enum.UserInputType.MouseMovement then

		local Delta =
			input.Position -
			DragStart

		Main.Position =
			UDim2.new(
				StartPosition.X.Scale,
				StartPosition.X.Offset +
					Delta.X,

				StartPosition.Y.Scale,
				StartPosition.Y.Offset +
					Delta.Y
			)

	end

end)

--========================================================
-- CHARACTER RESPAWN
--========================================================

Player.CharacterAdded:Connect(function()

	RemoveVirtualFloor()

	task.wait(1)

	if FPSBoost then

		CreateVirtualFloor()

		StartFullScan()

	end

end)

--========================================================
-- INITIAL UI
--========================================================

UpdateFPSUI()

print("================================")
print(" ULTRA FPS BOOST LOADED")
print(" Batch processing : ON")
print(" Object queue : ON")
print(" Virtual floor : ON")
print(" Auto detection : ON")
print(" Reapply : " .. ReapplyMode)
print("================================")
